# Copy this file to .env and fill in real values. Never commit .env.
SECRET_KEY=replace-with-a-long-random-string

# Stripe keys: https://dashboard.stripe.com/test/apikeys
# Use sk_test_... while developing; switch to sk_live_... to take real payments.
STRIPE_SECRET_KEY=sk_test_replace_me
# From `stripe listen --forward-to localhost:5000/webhook` or the Dashboard webhook endpoint.
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Optional
DATABASE_URL=sqlite:///shop.db
CURRENCY=usd
# Set to 1 in production (served over HTTPS).
SESSION_COOKIE_SECURE=0
# Number of reverse proxies in front of the app (e.g. 1 behind nginx/Render/Heroku)
# so rate limiting sees real client IPs. Leave 0 when serving directly.
TRUSTED_PROXIES=0
# Use Redis for rate limits when running multiple workers, e.g. redis://localhost:6379
RATELIMIT_STORAGE_URI=memory://
